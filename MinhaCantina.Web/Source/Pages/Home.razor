@page "/"
@using MinhaCantina.Biblioteca.DTOs;
@using System.Text.Json.Serialization
@using System.Text.Json
@inject IHttpClientFactory ClientFactory
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>


<main>

	<header id="carouselExample" class="carousel slide" data-bs-ride="carousel">
		<div class="carousel-inner">
			<div class="carousel-item active">
				<img src="https://thumbs.dreamstime.com/b/vista-vertical-superior-da-mesa-cheia-de-comida-e-bebidas-pessoas-felizes-amigos-celebrando-divirtam-se-comendo-juntos-divertindo-179552095.jpg" style="height: 300px;" class="d-block w-100 object-fit-cover" alt="...">
			</div>
			<div class="carousel-item">
				<img src="https://static.vecteezy.com/ti/fotos-gratis/t2/76051857-amor-comida-e-feliz-familia-cafe-da-manha-escovar-ou-almoco-para-grupo-do-pessoas-comendo-vinculo-e-apreciar-qualidade-tempo-junto-felicidade-manha-e-com-fome-grande-familia-sorrir-enquanto-relaxar-dentro-jantar-quarto-foto.jpg" style="height: 300px;" class="d-block w-100 object-fit-cover" alt="...">
			</div>
		</div>
		<button class="carousel-control-prev" type="button" data-bs-target="#carouselExample" data-bs-slide="prev">
			<span class="carousel-control-prev-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Previous</span>
		</button>
		<button class="carousel-control-next" type="button" data-bs-target="#carouselExample" data-bs-slide="next">
			<span class="carousel-control-next-icon" aria-hidden="true"></span>
			<span class="visually-hidden">Next</span>
		</button>
	</header>

<section class="container">
	<div class="row mb-4"> 
	@foreach(var produto in listaProdutos)
	{
		<Card Produto="produto" VerMais="AbrirDetalhes" />
	}
	</div>
	<Modal @ref="referenciaModal"></Modal>
</section>
</main>

@code {
	private IEnumerable<ProdutoRespostaDto>? listaProdutos = Array.Empty<ProdutoRespostaDto>();
	private Modal referenciaModal;

	protected override async Task OnInitializedAsync()
	{
		var cliente = ClientFactory.CreateClient();
		using var resposta = await cliente.GetAsync("https://localhost:7207/Produto/pegar_todos");

		if (resposta.IsSuccessStatusCode)
		{
			var resultado = await resposta.Content.ReadFromJsonAsync<IEnumerable<ProdutoRespostaDto>>();
			listaProdutos = resultado ?? Array.Empty<ProdutoRespostaDto>();
		}
	}
	private void AbrirDetalhes (ProdutoRespostaDto produto)
	{
		referenciaModal.Abrir(produto);
	}
}