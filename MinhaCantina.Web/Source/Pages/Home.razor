@page "/"
@using MinhaCantina.Biblioteca.DTOs;
@using System.Text.Json.Serialization
@using System.Text.Json
@inject IHttpClientFactory ClientFactory
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>


<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-lg ">
	<div class="container">
		<a class="navbar-brand d-flex flex-row gap-1 align-items-center text-danger">

			<img src="imagens/coxona.jpg" height="20" width="20"> MINHA CANTINA
		</a>
		<button class="navbar-toggler">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarNav">
			<ul class="navbar-nav ms-auto align-item-center">
				<li class="nav-item">
					<div class="input-group">
						<input @bind="_termoBusca" type="text" id="searchInput" class="form-control" placeholder="Buscar alimento...">
						<button class="input-group-text text-white" style="background-color:#f0aa42; border-color: #f0aa42;" @onclick="FiltrarProdutos">🔍</button>
					</div>
				</li>
			</ul>
		</div>
	</div>
</nav>

<header id="carouselCantina" class="carousel slide " data-bs-ride="carousel">
	<div class="carousel-inner">
		<div class="carousel-item active">
			<img src="imagens/carousel/SLIDE1.jpg" style="height: 400px;" class="d-block w-100 object-fit-cover" alt="...">
			<div class="carousel-caption d-none d-md-block">
				<h5 class="fw-bolder shadow-sm">Mais tempo juntas, menos tempo na fila.</h5>
				<p>Criamos esse site porque cada minuto do nosso intervalo merece ser vivido — não esperado.</p>
			</div>
		</div>

		<div class="carousel-item">
			<img src="imagens/carousel/SLIDE2.jpg" style="height: 400px;" class="d-block w-100 object-fit-cover" alt="...">
			<div class="carousel-caption d-none d-md-block">
				<h5 class="fw-bolder">Pedido feito em poucos cliques. Sabor aproveitado sem pressa.</h5>
				<p>Porque tecnologia boa é aquela que te devolve tempo.</p>
			</div>
		</div>

		<div class="carousel-item">
			<img src="imagens/carousel/SLIDE3.jpg" style="height: 400px;" class="d-block w-100 object-fit-cover" alt="...">
			<div class="carousel-caption d-none d-md-block">
				<h5 class="fw-bolder">Ideia de alunas. Solução para todo mundo.</h5>
				<p>
					Um site criado por jovens programadoras para transformar o intervalo em tempo de verdade.</p>
			</div>
		</div>

		<div class="carousel-item">
			<img src="imagens/carousel/SLIDE4.jpg" style="height: 400px;" class="d-block w-100 object-fit-cover" alt="...">
			<div class="carousel-caption d-none d-md-block">
				<h5 class="fw-bolder">Eles já estão prontos.</h5>
				<p>Peça agora e retire sem fila.</p>
			</div>
		</div>

	</div>
	<button class="carousel-control-prev" type="button" data-bs-target="#carouselCantina" data-bs-slide="prev">
		<img src="imagens/chave_abertura.png" heigth="32" width="32" />
		<span class="visually-hidden">Previous</span>
	</button>
	<button class="carousel-control-next" type="button" data-bs-target="#carouselCantina" data-bs-slide="next">
		<img src="imagens/chave_fechamento.png" height="32" widht="32"
		<span class="visually-hidden">Next</span>
	</button>
</header>


<section class="container mt-4">
	<div class="row mb-4">
		@foreach (var produto in _listaExibida)
		{
			<Card Produto="produto" VerMais="AbrirDetalhes" />
		}
	</div>
	<Modal @ref="_referenciaModal"></Modal>
</section>


@code {
	private IEnumerable<ProdutoRespostaDto>? _todosProdutos =[];
	private IEnumerable<ProdutoRespostaDto> _listaExibida = [];  
	private Modal _referenciaModal = null!;
	private string _termoBusca = "";

	protected override async Task OnInitializedAsync()
	{
		var cliente = ClientFactory.CreateClient();

		try
		{
			using var respostaProdutos = await cliente.GetAsync("https://localhost:7207/Produto/pegar_todos");
			if (respostaProdutos.IsSuccessStatusCode)
			{
				_todosProdutos = await respostaProdutos.Content.ReadFromJsonAsync<IEnumerable<ProdutoRespostaDto>>() ?? [];
			}
		}
		catch
		{
			Console.WriteLine("Ocorreu um erro");
		}
		finally
		{
			_listaExibida = _todosProdutos;
		}
	}

	private void BuscarNoEnter(KeyboardEventArgs e)
	{
		if (e.Key == "Enter")
		{
			FiltrarProdutos(e);
		}
	}

	private void FiltrarProdutos(EventArgs e)
	{

		if (string.IsNullOrWhiteSpace(_termoBusca))
		{
			_listaExibida = _todosProdutos;
		}
		else
		{
			_listaExibida = _todosProdutos?.Where(p =>
				p.Nome!.Contains(_termoBusca, StringComparison.OrdinalIgnoreCase)).ToList() ?? [];
		}
	}


	private void AbrirDetalhes(ProdutoRespostaDto produto)
	{
		_referenciaModal.Abrir(produto);
	}
}
