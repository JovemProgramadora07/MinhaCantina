@page "/"
@using MinhaCantina.Biblioteca.DTOs;

<PageTitle>Home</PageTitle>

<h1>Produtos</h1>

<section class="parent">
	 <Card Titulo="Coxinha" Descricao="Salgado frito fitness de frango" ValorReal="10M"
	ValorDesconto="7M" CaminhoImagem="/imagens/coxinha.webp" />

	<Card Titulo="Coca Cola 350ml" Descricao="Bebida gaseificada e bem gelada" ValorReal="5M"
	ValorDesconto="4.75M" CaminhoImagem="/imagens/cocacola350.webp" />

	<Card Titulo="Brownie Chocolatudo" Descricao="Brownie de chocolate a base de Nutella" ValorReal="15M" ValorDesconto="10M" CaminhoImagem="/imagens/brownie.webp" /> 
	@foreach(var produto in listaProdutos)
	{
		<Card Titulo="@produto.Nome" ValorReal="@produto.Preco" />
	}

</section>

@code {
	private List<ProdutoRespostaDto> listaProdutos = new()
	{
		new ProdutoRespostaDto{ Id = 1, Nome = "Coxinha", Preco = 10M },
		new ProdutoRespostaDto{ Id = 2, Nome = "Coca Cola", Preco = 5M },
		new ProdutoRespostaDto{ Id = 3, Nome = "Brownie", Preco = 15M },
	};
}