@page "/login"
@using MinhaCantina.Biblioteca.DTOs
@using System.Text.Json
@using System.Text
@using static System.Net.Mime.MediaTypeNames
@inject IHttpClientFactory Mediador


<PageTitle>Entrar com a sua conta</PageTitle>

<h3>Login</h3>

<form class="mt-5" style="max-width: 250px;">
    <div class="form-outline mb-4">
        <label class="form-label" for="usuario">Username</label>
        <input type="text" id="usuario" class="form-control" />
    </div>

    <div class="form-outline mb-4">
        <label class="form-label" for="senha">Senha</label>
        <input type="password" id="senha" class="form-control" />
    </div>

    <input type="button" class="btn btn-primary btn-block mb-4" value="Entrar">
</form>

@code {
    private UsuarioLoginDto InfoLogin { get; set; }

    private async void Autenticar()
    {
        var usuario = new UsuarioLoginDto()
            {
                Username = "Yasmin",
                Senha = "GatinhaFofoqueira"
            };

        var requisicao = new StringContent
        (JsonSerializer.Serialize(usuario),
        Encoding.UTF8,
        Application.Json);

        var Carteiro = Mediador.CreateClient();

        var resposta = await Carteiro.PostAsync("https://localhost:7207/login ", requisicao);


        if (resposta.IsSuccessStatusCode) ;
        {
            var ConteudoResposta = await resposta.Content.ReadFromJsonAsync<UsuarioRespostaDto>();

        }
    }
}
