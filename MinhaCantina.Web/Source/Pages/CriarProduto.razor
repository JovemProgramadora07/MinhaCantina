@page "/cria-produto"
@using MinhaCantina.Biblioteca.DTOs
@inject IHttpClientFactory Mediador
@rendermode InteractiveServer

<PageTitle>Criar um Produto | Minha Cantina</PageTitle>

<div class="mc-page-container">
    <header class="mc-header shadow-sm">
        <div class="container d-flex align-items-center justify-content-between">
            <h2 class="mc-title">Novo Produto</h2>
            <a href="/" class="btn btn-outline-secondary btn-sm">Voltar ao Início</a>
        </div>
    </header>

    <main class="container my-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="mc-form-card shadow">

                    <div class="row g-4">
                        <div class="col-md-5 text-center border-end">
                            <label class="form-label fw-bold">Preview do Produto</label>
                            <div class="mc-image-preview">
                                @if (string.IsNullOrEmpty(_produto.ImagemURL))
                                {
                                    <div class="mc-placeholder">
                                        <i class="bi bi-image"></i>
                                        <span>Sem imagem</span>
                                    </div>
                                }
                                else
                                {
                                    <img src="@_produto.ImagemURL" class="img-fluid rounded" alt="Preview" />
                                }
                            </div>
                            <div class="mt-3 text-start">
                                <label class="form-label">URL da Imagem</label>
                                <input @bind="_produto.ImagemURL" @bind:event="oninput" type="text" class="form-control" placeholder="https://...">
                            </div>
                        </div>

                        <div class="col-md-7">
                            <div class="mb-3">
                                <label class="form-label fw-bold">Nome do Produto</label>
                                <input @bind="_produto.Nome" type="text" class="form-control form-control-lg" placeholder="Ex: Coca-Cola 350ml">
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label class="form-label fw-bold">Preço (R$)</label>
                                    <input @bind="_produto.Preco" type="number" step="0.01" class="form-control" placeholder="0,00">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-bold">Categoria</label>
                                    <div class="input-group">
                                        <select @bind="_produto.CategoriaId" class="form-select mc-select-custom">
                                            <option value="0" disabled selected>Selecione uma categoria...</option>
                                            @foreach (var cat in _listaCategorias)
                                            {
                                                <option value="@cat.Id">@cat.Nome</option>
                                            }
                                        </select>

                                        <button class="btn btn-outline-warning mc-btn-add"
                                                type="button"
                                                @onclick="AbrirModalCategoria"
                                                title="Cadastrar nova categoria">
                                            <span class="fw-bold">+</span>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <ModalCategoria @ref="_modalCategoriaRef" OnCategoriaCriada="AtualizarCategorias" />

                            <div class="mb-4">
                                <label class="form-label fw-bold">Descrição</label>
                                <textarea @bind="_produto.Descricao" class="form-control" rows="3" placeholder="Detalhes do produto..."></textarea>
                            </div>

                            <button class="mc-btn-save w-100" @onclick="CriaProduto" disabled="@_isEnviando">
                                @if (_isEnviando)
                                {
                                    <span class="spinner-border spinner-border-sm me-2"></span>
                                    <span>Salvando...</span>
                                }
                                else
                                {
                                    <span>Cadastrar Produto</span>
                                }
                            </button>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private ProdutoRegistroDto _produto = new();
    private IEnumerable<CategoriaRespostaDto> _listaCategorias = [];
    private ModalCategoria? _modalCategoriaRef;
    private bool _isEnviando;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var cliente = Mediador.CreateClient();
            var resposta = await cliente.GetFromJsonAsync<IEnumerable<CategoriaRespostaDto>>("https://localhost:7207/Categoria/pegar_todos");
            _listaCategorias = resposta ?? [];
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar categorias: {ex.Message}");
        }
    }

    private async Task CriaProduto()
    {
        if (_produto.CategoriaId == 0) return;

        _isEnviando = true;
        try
        {
            var cliente = Mediador.CreateClient();

            var resposta = await cliente.PostAsJsonAsync("https://localhost:7207/Produto/criar", _produto);

            if (resposta.IsSuccessStatusCode)
            {
                _produto = new ProdutoRegistroDto();
            }
        }
        finally
        {
            _isEnviando = false;
        }
    }

    private void AbrirModalCategoria()
    {
        _modalCategoriaRef?.Exibir();
    }

    private async Task AtualizarCategorias()
    {
        var cliente = Mediador.CreateClient();
        var resposta = await cliente.GetFromJsonAsync<IEnumerable<CategoriaRespostaDto>>("https://localhost:7207/Categoria/pegar_todos");
        _listaCategorias = resposta ?? [];
        StateHasChanged();
    }
}