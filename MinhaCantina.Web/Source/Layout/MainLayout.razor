@inherits LayoutComponentBase

<nav class="navbar navbar-expand-lg navbar-light bg-white sticky-top shadow-lg">
	<div class="container">
		<a class="navbar-brand d-flex flex-row gap-1 align-items-center text-danger"> 

		<img src="imagens/coxona.jpg" height="20" width="20"> MINHA CANTINA
		</a>
		<button class="navbar-toggler">
			<span class="navbar-toggler-icon"></span>
		</button>
		<div class="collapse navbar-collapse" id="navbarNav">
			<ul class="navbar-nav ms-auto align-item-center">
				<li class="nav-item">
					<div class="input-group">
						<input type="text" id="searchInput" class="form-control" placeholder="Buscar alimento...">
						<span class="input-group-text text-white" style="background-color:#f0aa42; border-color: #f0aa42;">🔍</span>
					</div>
				</li>
			</ul>
		</div>
	</div>
</nav>

<main>
	<article class="content px-4">
		@Body
	</article>
</main>
<div id="blazor-error-ui">
	An unhandled error has occurred.
	<a href="" class="reload">Reload</a>
	<a class="dismiss">🗙</a>
</div>
<footer>
	<div class="container text-center">
		<p class="mb-0">@@ 2026 Cantina Viva - Jovem Programadora</p>
		<small class="text-muted">Horário de funcionamento: 07:00 às 22:00</small>
	</div>
</footer>