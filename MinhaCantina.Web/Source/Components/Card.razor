@using MinhaCantina.Biblioteca.DTOs
@rendermode InteractiveServer

<div class="col-sm-6 col-md-4 col-lg-3">

	<div class="card card-product shadow-sm h-100">
		<span class="badge-stock @PegaCor()">@PegaStatus()</span>
		<img src="@Produto.ImagemURL" class="card-img-top" alt="...">

		<div class="card-body">
			<h5 class="card-title fw-bold mb-1">@Produto.Nome</h5>
			<p class="text-muted small mb-2">@Produto.CategoriaNome</p>
			<div class="d-flex justify-content-between align-items-center">
				<span class="price-tag">R$ @Produto.Preco</span>
				<button @onclick="() => VerMais.InvokeAsync(Produto)" class="btn btn-outline-primary btn-sm rounded-pill">Ver mais</button>
			</div>
		</div>
	</div>
</div>
@code {
	[Parameter] public required ProdutoRespostaDto Produto { get; set; }
	[Parameter] public Status StatusProduto { get; set; } = Status.Disponivel;
	[Parameter] public EventCallback<ProdutoRespostaDto> VerMais { get; set; }

	protected override void OnInitialized()
	{
		var values = Enum.GetValues(typeof(Status));
		var random = new Random();
		var randomBar = (Status)(values.GetValue(random.Next(values.Length)) ?? 0);
		StatusProduto = randomBar;
	}

	public enum Status
	{
		Esgotado,
		PoucasUnidades,
		Disponivel,
	}

	private string PegaCor()
	{
		return StatusProduto switch
		{
			Status.Disponivel => "bg-success",
			Status.Esgotado => "bg-danger",
			_ => "bg-warning"
		};
	}

	private string PegaStatus()
	{
		return StatusProduto switch
		{
			Status.Disponivel => "Disponível",
			Status.Esgotado => "Esgotado",
			_ => "Poucas Unidades"
		};
	}

}