@using static MinhaCantina.Web.Source.Components.Card
@inject IJSRuntime JS
@rendermode InteractiveServer

<div class="modal fade show" id="productModal" tabindex="-1" style="display:none" aria-hidden="true">
	<div class="modal-dialog modal-dialog-centered">
		<div class="modal-content border-0 shadow">
			<div class="modal-header">
				<h5 class="modal-title fw-bold" id="modalTitle"></h5>
				<button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" @onclick="FecharModal"></button>
			</div>
			<div class="modal-body text-center">
				<img id="modalImg" src="imagens/brownie.webp" class="img-fluid rounded mb-3 product-img w-100" alt="Produto" />
				<p id="modalDesc" class="text-muted"></p>
				<div class="d-flex justify-content-between align-items-center px-3">
					<span id="modalPrice" class="price-tag"></span>
					<span id="modalStock" class="badge bg-info"></span>
				</div>
			</div>
		</div>
	</div>
</div>

@code {
	// [Parameter] public string Titulo { get; set; } = string.Empty;
	// [Parameter] public string Descricao { get; set; } = string.Empty;
	// [Parameter] public decimal ValorReal { get; set; }
	// [Parameter] public decimal ValorDesconto { get; set; }
	// [Parameter] public string CaminhoImagem { get; set; } = string.Empty;
	// [Parameter] public Status StatusProduto { get; set; } = Status.Disponivel;

	private async void FecharModal()
	{
		await JS.InvokeVoidAsync("fechaModal");
	}
}