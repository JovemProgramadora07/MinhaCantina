@using MinhaCantina.Biblioteca.DTOs
@using static MinhaCantina.Web.Source.Components.Card

@if (estaVisivel)
{
    <div class="modal-overlay">
        <div class="modal-container">
            <div class="modal-header">
                <h3>@ProdutoSelecionado.Nome</h3>
                <button class="close-btn" @onclick="FecharModal">&times;</button>
            </div>
			<div class="modal-media">
				<img src="@ProdutoSelecionado.ImagemURL" alt="Destaque" class="modal-img" />
			</div>
            <div class="modal-body">
                <p>@ProdutoSelecionado.Descricao</p>
            </div>
			<div class="modal-footer">

				<span>@ProdutoSelecionado.Preco</span>
				

			</div>
        </div>
    </div>
}
@code {
	public ProdutoRespostaDto ProdutoSelecionado { get; set; }
	private bool estaVisivel = false;

	public void Abrir(ProdutoRespostaDto produto)
	{
		ProdutoSelecionado = produto;
		estaVisivel = true;
		StateHasChanged();
	}

	private void FecharModal()
	{
		estaVisivel = false;
	}
}